{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrawl",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/api/*", "/p/*", "/setup.md", "/skill/*", "/guide.md", "/recipes/*", "/examples/*"] },
  "r2_buckets": [{ "binding": "IMAGES" }],
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    { "binding": "DB", "migrations_dir": "migrations" }
  ],
  "vars": {
    "MAX_PAD_BYTES": "1000000",
    "PUBLISH_LIMIT": "20",
    "PUBLISH_WINDOW_SECONDS": "3600",
    "PAD_DOMAIN": "",
    "REPORT_HIDE_THRESHOLD": "3",
    "PAD_TTL_DAYS": "30",
    "PAD_MAX_TTL_DAYS": "365",
    "IMAGE_MAX_BYTES": "2000000",
    "IMAGE_MAX_PER_PAD": "20",
    "CDN_ALLOWLIST": "cdn.jsdelivr.net cdnjs.cloudflare.com unpkg.com cdn.tailwindcss.com fonts.googleapis.com fonts.gstatic.com esm.sh"
  }
}
